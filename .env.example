# Bu dosyayı .env adıyla kopyalayın. .env dosyası git'e EKLENMEZ (bkz. .gitignore).
# Anahtar üretmek için:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=buraya-uzun-rastgele-bir-anahtar-yazin
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# İki MySQL veritabanı (WampServer): DB_NAME otel verisi, DB_SYSTEM_NAME Django'nun kendi tabloları. root + boş parola yalnızca kendi bilgisayarınızda kabul edilebilir;
# README'deki "Ayrı veritabanı kullanıcısı" bölümüne bakın.
DB_NAME=pasaport_otel
DB_SYSTEM_NAME=pasaport_sistem
DB_USER=root
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306
